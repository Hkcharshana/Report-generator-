# ==============================================================================
#  NEOSYS MEDICARE LOCAL GENERATOR - ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

PORT=1516
HOST=0.0.0.0
NODE_ENV=production
APP_NAME="NeoSys Medicare Local Generator"

# H360 HL7 Settings
H360_PORT=5600
H360_HOST=0.0.0.0
H360_AUTO_ACK=true
H360_AUTO_SYNC=true
H360_PROTOCOL=ORR_O02

# NeoSys Portal
NEOSYS_BASE_URL=https://neosys.lk
NEOSYS_DEFAULT_BRANCH=pettah
NEOSYS_PETTAH_USER=
NEOSYS_PETTAH_PASS=
NEOSYS_COLOMBO_USER=
NEOSYS_COLOMBO_PASS=

# Report Metadata
REPORT_TIMEZONE=Asia/Colombo
SIGNATORY_NAME="W.D.Gunarathne"
SIGNATORY_TITLE="Chief Medical Laboratory Technologist"
SIGNATORY_QUALIFICATIONS="D.M.L.T.,(Sri Lanka) / S.L.M.C 0012 "
SIGNATORY_FELLOWSHIP="W.H.O.Fellow"

# Paths
FRONTEND_DIR=./frontend
BACKEND_DIR=./backend
ASSETS_DIR=./frontend/assets
